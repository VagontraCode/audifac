<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcut icon: a light disc with the symbol in the app's ink. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_art" />
        </shape>
    </item>
    <item android:drawable="@drawable/shortcut_search_symbol" android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp" />
</layer-list>
